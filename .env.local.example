# Groq API key — free tier, create one at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the default model (openai/gpt-oss-20b)
# GROQ_MODEL=llama-3.3-70b-versatile

# Public address of the site, used for canonical URLs, sitemap, robots.txt and share cards
# NEXT_PUBLIC_SITE_URL=https://example.com
